{
    "configurations": [
        {
            "name": "skia_test",
            "includePath": [ "${default}" ],
            "defines": [ "_GLIBCXX_DEBUG" ],
            "compilerPath": "/opt/homebrew/opt/llvm/bin/clang++",
            "cStandard": "c17",
            "cppStandard": "c++20",
            "intelliSenseMode": "macos-clang-arm64"
        }, 
        {
            "name": "skia_test_asan",
            "includePath": [ "${default}" ],
            "defines": [ "_GLIBCXX_DEBUG" ],
            "compilerPath": "/opt/homebrew/opt/llvm/bin/clang++",
            "compilerArgs": [
                "-fsanitize=address",
                "-fno-omit-frame-pointer",
                "-Wno-invalid-offsetof"
            ],
            "cStandard": "c17",
            "cppStandard": "c++20",
            "intelliSenseMode": "macos-clang-arm64"
        },
        {
            "name": "test_drive",
            "includePath": [ "${default}" ],
            "defines": [ "OP_DEBUG_FAST_TEST=1", "_GLIBCXX_DEBUG" ],
            "compilerPath": "/opt/homebrew/opt/llvm/bin/clang++",
            "cStandard": "c17",
            "cppStandard": "c++20",
            "intelliSenseMode": "macos-clang-arm64"
        }
    ],
    "version": 4
}